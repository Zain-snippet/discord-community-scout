# Copy to .env and adjust. Never commit .env.
#
# Port the HTTP server listens on.
PORT=8080

# SQLite database location. `mode=rwc` creates the file if it is missing.
DATABASE_URL=sqlite://data/scout.db?mode=rwc

# Log filter, e.g. info, debug, discord_community_scout=debug,tower_http=debug
RUST_LOG=info,tower_http=info

# How long a discovery source response is cached, in seconds (default 1 hour).
SCOUT_CACHE_TTL_SECS=3600

# Directory for OAuth tokens, snapshots and recovery copies (default: data).
# Keep this outside version control. It must be writable by the app.
SCOUT_DATA_DIR=data

# ---------------------------------------------------------------------------
# Optional: Google Drive sync
# ---------------------------------------------------------------------------
# Leave GOOGLE_CLIENT_ID unset to keep sync disabled. The app then works
# entirely locally and never contacts Google. See docs/google-drive-setup.md.
#
# The OAuth client id and (for the Desktop client type) secret are read on the
# server only. They are never sent to the browser and must not be committed.
# GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-example-secret

# The exact base URL this server is reached at; used to build the OAuth
# redirect. Must match a redirect URI registered in Google Cloud:
#   <SCOUT_PUBLIC_URL>/api/auth/google/callback
# Defaults to http://127.0.0.1:<PORT> when unset.
# SCOUT_PUBLIC_URL=http://127.0.0.1:8080
