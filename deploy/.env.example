# Deployment settings for docker compose + Caddy (Oracle Cloud Always Free).
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# deploy/.env is git-ignored. Never commit it or the plaintext password.

# ---------------------------------------------------------------------------
# Public hostname and TLS
# ---------------------------------------------------------------------------
# Hostname only - no scheme, no path, no trailing slash.
# Using DuckDNS? Use the full hostname here, e.g. scout-example.duckdns.org
# Caddy will obtain a certificate for exactly this name.
SITE_ADDRESS=scout-example.duckdns.org

# Contact address for the ACME account (certificate expiry notices).
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Basic Authentication (Caddy protects the whole site)
# ---------------------------------------------------------------------------
BASIC_AUTH_USER=scout

# Generate the hash ON THE VM (the plaintext password is never stored or
# committed):
#
#   docker run --rm caddy:2.8-alpine \
#     caddy hash-password --plaintext 'choose-a-long-random-password'
#
# Paste the hash below INSIDE SINGLE QUOTES. Single quotes are required: the
# hash contains "$" characters, and docker compose would otherwise try to
# interpolate them as variables and silently corrupt the hash.
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_BCRYPT_HASH'

# ---------------------------------------------------------------------------
# Optional DuckDNS updater (compose profile "duckdns")
# ---------------------------------------------------------------------------
# Only needed when SITE_ADDRESS is a *.duckdns.org name and the VM's public
# IP can change (for example after recreating the instance). Leave blank when
# using your own domain. Never commit the token.
DUCKDNS_SUBDOMAIN=scout-example
DUCKDNS_TOKEN=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
TZ=UTC
RUST_LOG=info,tower_http=info
SCOUT_CACHE_TTL_SECS=3600

# ---------------------------------------------------------------------------
# Optional: Google Drive sync
# ---------------------------------------------------------------------------
# Leave GOOGLE_CLIENT_ID empty to keep sync disabled (the app is fully usable
# locally). To enable it, create an OAuth "Web application" client in Google
# Cloud and register this exact redirect URI:
#
#   https://<SITE_ADDRESS>/api/auth/google/callback
#
# See docs/google-drive-setup.md. The secret lives only in this file (mode 600)
# and on the server; it is never sent to the browser.
# GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-example-secret

# Must be the public base URL, including https:// and no trailing slash. It
# has to match the redirect URI registered in Google Cloud, so keep it equal
# to https://<SITE_ADDRESS>. Only needed when Google sync is enabled.
# SCOUT_PUBLIC_URL=https://scout-example.duckdns.org

# ---------------------------------------------------------------------------
# Backups (used by scripts/backup-db.sh and friends; host-side settings)
# ---------------------------------------------------------------------------
# Directory on the VM for compressed SQLite backups. Keep it outside the repo.
BACKUP_DIR=/var/backups/discord-community-scout

# Backups older than this many days are pruned.
BACKUP_RETENTION_DAYS=14

# Optional encrypted off-site copy. Both are unset by default; backups stay
# on the VM until you configure and TEST an off-site destination.
#
# age recipient (public key) for encryption, e.g. age1...
# BACKUP_AGE_RECIPIENT=
#
# rclone remote (OCI Object Storage, Always Free tier) to copy encrypted
# backups to, e.g. oci:scout-backups
# BACKUP_RCLONE_REMOTE=
